{
  "seed": 44,
  "distribution": false,
  "exp_name": "evofedaffinity_demo",
  "log": {
    "metric_compute": "sample-wise"
  },
  "data": {
    "dataset_name": "AbBibench/Antibody_Binding_Benchmark_Dataset",
    "group": "pkd",
    "num_clients": 16,
    "meta-key": {
      "shared_key_equilibrium": {
        "enabled": false,
        "key": "4fqi"
      },
      "dirichlet": {
        "enabled": true,
        "alpha": 0.2
      }
    },
    "cache_dir": "data/abbibench",
    "batch_size": 256,
    "num_workers": 12,
    "test_ratio": 0.1,
    "split_strategy": "meta-key"
  },
  "model": {
    "esm_path": "facebook/esm2_t6_8M_UR50D",
    "peft_implementation": {
      "feature_space": {
        "feature_space_adaptor": {
          "mlp": {
            "hidden_dim": null,
            "dropout": 0.1
          },
          "mint": {
            "hidden_dim": null,
            "dropout": 0.1,
            "transformer_heads": 4
          },
          "antibinder": {
            "hidden_dim": null,
            "dropout": 0.1,
            "transformer_heads": 4
          },
          "duadeep": {
            "hidden_dim": null,
            "dropout": 0.1,
            "transformer_layers": 1,
            "transformer_heads": 4
          }
        }
      }
    }
  },
  "train": {
    "fedavg": {
      "comm_rounds": 1000,
      "local_epochs": 1,
      "miss_client_ratio": 0,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "fedavgM": {
      "comm_rounds": 1000,
      "local_epochs": 3,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0
      },
      "server_update": {
        "lr": 1.0,
        "beta": 0.9
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "fedadamW": {
      "comm_rounds": 1000,
      "local_epochs": 3,
      "client_optimizer": {
        "name": "adamw",
        "lr": 0.01,
        "beta1": 0.9,
        "beta2": 0.999,
        "eps": 1e-08,
        "weight_decay": 0.0
      },
      "server_update": {
        "alpha": 0.1
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "fedprox": {
      "comm_rounds": 1000,
      "local_epochs": 3,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0,
        "prox_mu": 1
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "scaffold": {
      "comm_rounds": 1000,
      "local_epochs": 1,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0,
        "scaffold_correction": true
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "feddisco": {
      "comm_rounds": 1000,
      "local_epochs": 1,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0
      },
      "server_update": {
        "disco_a": 0.5,
        "disco_b": 0.1
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "fedimpro": {
      "comm_rounds": 1000,
      "local_epochs": 1,
      "client_optimizer": {
        "name": "sgd",
        "lr": 0.01,
        "weight_decay": 0.0
      },
      "prototype": {
        "loss_weight": 1.0,
        "label_bins": 500,
        "label_min": 6,
        "label_max": 13
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    },
    "fedmoswa": {
      "comm_rounds": 1000,
      "eta_l": 0.01,
      "rho": 0.01,
      "alpha": 0.1,
      "gamma": 0.5,
      "local_epochs": 1,
      "client_optimizer": {
        "name": "sgd",
        "weight_decay": 0.0
      },
      "loss": {
        "gaussian_nll": 1.0
      },
      "clip_norm": 1.0
    }
  }
}
